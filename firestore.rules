rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /posts/{postId} {
      // Public can read only published posts.
      allow read: if resource.data.status == "published";

      // Only the admin account can read drafts, create, update, or delete.
      // Replace ADMIN_EMAIL with your actual sign-in email before deploying.
      allow read, write: if request.auth != null
        && request.auth.token.email == "ADMIN_EMAIL";
    }

    match /projects/{projectId} {
      // Public can read only published projects.
      allow read: if resource.data.published == true;

      // Only the admin account can read hidden/draft projects, create,
      // update, or delete. Same ADMIN_EMAIL placeholder as above.
      allow read, write: if request.auth != null
        && request.auth.token.email == "ADMIN_EMAIL";
    }

    match /messages/{messageId} {
      // The public "Get in touch" contact form writes here directly with
      // no auth — this is the one write shape it's allowed: a brand-new
      // message, starting unread, with exactly the fields the form sends
      // and reasonable length caps (cheap abuse mitigation now that
      // anyone can hit this endpoint without signing in). It can never
      // read, update, or delete — only create.
      allow create: if request.resource.data.keys().hasOnly(
                        ["name", "email", "phone", "message", "read", "createdAt"]
                      )
                      && request.resource.data.read == false
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.name.size() <= 200
                      && request.resource.data.email is string
                      && request.resource.data.email.size() > 0
                      && request.resource.data.email.size() <= 320
                      && request.resource.data.phone is string
                      && request.resource.data.phone.size() > 0
                      && request.resource.data.phone.size() <= 40
                      && request.resource.data.message is string
                      && request.resource.data.message.size() > 0
                      && request.resource.data.message.size() <= 5000;

      // Only the admin account can list messages, mark them read/unread,
      // or delete them. Same ADMIN_EMAIL placeholder as above.
      allow read, update, delete: if request.auth != null
        && request.auth.token.email == "ADMIN_EMAIL";
    }
  }
}
