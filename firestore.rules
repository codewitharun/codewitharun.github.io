rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /posts/{postId} {
      // Public can read only published posts.
      allow read: if resource.data.status == "published";

      // Only the admin account can read drafts, create, update, or delete.
      // Replace ADMIN_EMAIL with your actual sign-in email before deploying.
      allow read, write: if request.auth != null
        && request.auth.token.email == "ADMIN_EMAIL";
    }

    match /projects/{projectId} {
      // Public can read only published projects.
      allow read: if resource.data.published == true;

      // Only the admin account can read hidden/draft projects, create,
      // update, or delete. Same ADMIN_EMAIL placeholder as above.
      allow read, write: if request.auth != null
        && request.auth.token.email == "ADMIN_EMAIL";
    }
  }
}
